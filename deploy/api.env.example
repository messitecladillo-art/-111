# Production template: inject through your process manager or secret store.
# Replace all REPLACE values. Never commit a filled copy.
EVIX_MODE=production
EVIX_DATABASE_URL=postgresql+psycopg://evix_app:REPLACE@postgres:5432/evix
EVIX_ALLOWED_ORIGINS=["https://REPLACE.example.com"]
EVIX_INVITED_EMAILS=["REPLACE@example.com"]
EVIX_AUTH_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
EVIX_KEYRING={"v1":"REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS"}
EVIX_ACTIVE_KEY_ID=v1
EVIX_COOKIE_NAME=__Host-evix_session
EVIX_MAIL_MODE=resend
EVIX_PROVIDER_MODE=live
EVIX_MAIL_API_KEY=REPLACE
EVIX_MAIL_FROM=REPLACE@example.com
EVIX_COMPATIBLE_BASES=[]
# Migration job only, never inject the owner URL into the API process:
# EVIX_MIGRATION_DATABASE_URL=postgresql+psycopg://evix_owner:REPLACE@postgres:5432/evix
