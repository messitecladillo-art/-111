  "typography": {
    "families": {
      "display_zh": "Source Han Sans SC",
      "body_sans_zh": "Source Han Sans SC",
      "body_serif_zh": "Source Han Serif SC",
      "latin_numeric": "Inter",
      "mono": "IBM Plex Mono"
