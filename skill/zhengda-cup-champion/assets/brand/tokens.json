    "unit": 8,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "display": 64
  },
  "radius_px": {
    "small": 6,
    "card": 12,
    "feature": 20,
    "pill": 999
  },
  "stroke": {
    "icon_grid_px": 24,
    "icon_standard_px": 2,
    "slide_standard_px": 2,
    "print_positive_min_mm": 0.3,
    "print_reverse_min_mm": 0.4
  },
  "layout": {
    "grid_unit_px": 8,
    "ppt": {
      "width_px": 1920,
      "height_px": 1080,
      "columns": 12,
      "safe_margin_horizontal_px": 96,
      "safe_margin_vertical_px": 64
    },
    "report": {
      "page": "A4",
      "width_mm": 210,
      "height_mm": 297,
      "bleed_mm": 3,
      "safe_margin_from_trim_mm": 5
    },
    "avatar": {
      "master_px": 1024,
      "subject_safe_zone_percent": 70,
      "export_px": [
        512,
        256,
        128,
        64,
        32,
        16
      ]
    }
  },
  "iconography": {
    "primitives": [
      "question_entry",
      "data_network",
      "insight_prism",
      "action_path"
    ],
    "stroke_cap": "round",
    "stroke_join": "round",
    "solid_below_px": 16,
    "emoji_in_formal_artifacts": false
  },
  "data_visualization": {
    "categorical_palette": [
      "#00796F",
      "#2367E8",
      "#F4B942",
      "#B83239",
      "#536677",
      "#00B3A4"
    ],
    "color_only_encoding": false,
    "direct_labels_preferred": true,
    "three_dimensional_charts": false,
    "vector_output_preferred": true,
    "required_metadata": [
      "title",
      "unit",
      "sample_base_n",
      "time_scope",
      "source",
      "method_if_needed"
    ],
    "required_checks": [
      "grayscale",
      "color_vision_deficiency",
      "weak_projector",
      "cross_file_numeric_consistency"
    ]
  },
  "accessibility": {
    "wcag_normal_text_ratio_min": 4.5,
    "wcag_large_text_ratio_min": 3,
    "wcag_non_text_ratio_min": 3,
    "alt_text_for_informative_images": true,
    "data_table_for_key_charts": true,
    "tagged_pdf_and_reading_order": true,
    "maximum_flashes_per_second": 3
  },
  "print": {
    "raster_ppi_min_at_final_size": 300,
    "preferred_pdf_standard": "PDF/X-4",
    "convert_with_target_printer_icc": true,
    "brand_color_proof_delta_e_00_max": 3,
    "body_black": "K100",
    "rich_black_requires_printer_profile": true,
    "foil_gold_requires_spot_layer": true
  },
  "modes": {
    "agent_ui": {
      "label": "Product",
      "brand_mark": "allowed",
      "mascot": "allowed",
      "ai_concept_image": "allowed_with_ledger",
      "official_or_third_party_mark": "authorized_original_only",
      "non_official_disclosure": "required_when_affiliation_could_be_inferred"
    },
    "public_promo": {
      "label": "Public",
      "brand_mark": "allowed_reduced",
      "mascot": "allowed_when_relevant",
      "ai_concept_image": "allowed_with_label_if_fact_confusion_is_possible",
      "official_or_third_party_mark": "authorized_original_only",
      "non_official_disclosure": "required",
      "non_official_disclosure_text_zh": "证见 EVI-X 为独立研究辅助工具，非“正大杯”赛事官方产品，与赛事主办方、承办方及冠名单位无隶属、授权或合作关系。"
    },
    "competition_submission": {
      "label": "Competition",
      "brand_mark": "hidden_by_default",
      "mascot": "hidden_by_default",
      "watermark": "forbidden_by_default",
      "ai_concept_image": "exception_only_after_rule_and_evidence_review",
      "official_or_third_party_mark": "current_scoped_rule_and_authorization_required",
      "asset_admission": "explicit_whitelist_only",
      "anonymity_review": "required"
    }
  },
  "integrity": {
    "ai_images_are_concept_only": true,
    "ai_images_as_fieldwork_evidence": false,
    "ai_images_as_data_or_model_output": false,
    "ai_redraw_of_official_marks": false,
    "generated_text_in_final_art": false,
    "ai_use_ledger_required": true,
    "competition_asset_whitelist_required": true
