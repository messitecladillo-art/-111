{
  "schema_version": "1.0.0",
  "token_set_id": "evi-x-core",
  "brand": {
    "name_zh": "证见",
    "name_en": "EVI-X",
    "descriptor_zh": "正大杯全流程循证竞赛智能体",
    "slogan_primary_zh": "让每个问题，都循证抵达行动。",
    "slogan_short_zh": "问有据，见有策。",
    "promise_zh": "把真实问题连接到可复核证据、可靠洞察和可执行行动。",
    "attributes": [
      "真实",
      "敏锐",
      "克制",
      "能打"
    ],
    "official_affiliation": false
  },
  "color": {
    "ink_navy": {
      "value": "#0A1F33",
      "rgb": [10, 31, 51],
      "name_zh": "墨证蓝",
      "role": "主文字、深色背景、封面"
    },
    "insight_teal": {
      "value": "#00B3A4",
      "rgb": [0, 179, 164],
      "name_zh": "洞见青",
      "role": "主交互、重点数据、棱镜"
    },
    "insight_teal_dark": {
      "value": "#00796F",
      "rgb": [0, 121, 111],
      "name_zh": "深洞见青",
      "role": "白底链接、正文强调、图表系列"
    },
    "evidence_gold": {
      "value": "#F4B942",
      "rgb": [244, 185, 66],
      "name_zh": "证据金",
      "role": "核心洞察、通过状态、决策节点"
    },
    "action_coral": {
      "value": "#FF5A5F",
      "rgb": [255, 90, 95],
      "name_zh": "行动珊瑚",
      "role": "风险、异常、阻断"
    },
    "risk_red_dark": {
      "value": "#B83239",
      "rgb": [184, 50, 57],
      "name_zh": "深风险红",
      "role": "白底错误文字、图表风险系列"
    },
    "proof_blue": {
      "value": "#2367E8",
      "rgb": [35, 103, 232],
      "name_zh": "证明蓝",
      "role": "链接、基准、对照系列"
    },
    "paper_ivory": {
      "value": "#F7F4ED",
      "rgb": [247, 244, 237],
      "name_zh": "纸张暖白",
      "role": "报告与编辑式背景"
    },
    "mist_blue_gray": {
      "value": "#E7EEF3",
      "rgb": [231, 238, 243],
      "name_zh": "雾蓝灰",
      "role": "卡片、分区、隔行底色"
    },
    "slate_gray": {
      "value": "#536677",
      "rgb": [83, 102, 119],
      "name_zh": "石板灰",
      "role": "次级文字、注释、图表系列"
    },
    "white": {
      "value": "#FFFFFF",
      "rgb": [255, 255, 255],
      "name_zh": "白",
      "role": "高对比背景或深色底文字"
    }
  },
  "semantic_color": {
    "text_primary": "{color.ink_navy.value}",
    "text_secondary": "{color.slate_gray.value}",
    "text_link": "{color.proof_blue.value}",
