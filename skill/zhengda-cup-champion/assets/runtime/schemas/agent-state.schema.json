{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evi-x.local/schemas/agent-state.schema.json",
  "title": "Zhengda Cup Champion Agent State",
  "description": "Authoritative control-plane state for orchestration, gates, events, checkpoints, and recovery.",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "workflow",
    "status",
    "status_revision",
    "project_revision",
    "project_status_mirror",
    "active_node",
    "run",
    "gates",
    "latest_checkpoint",
    "event_stream",
    "recovery",
    "transition_history",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "gate_contract_id",
        "gate_contract_version"
      ],
      "properties": {
        "contract_id": {
          "const": "zhengda-cup-champion.workflow"
        },
        "version": {
          "const": "1.0.0"
        },
        "gate_contract_id": {
          "const": "zhengda-cup-champion.gates"
        },
        "gate_contract_version": {
          "const": "1.0.0"
        }
      }
    },
    "status": {
      "$ref": "#/$defs/controlStatus"
    },
    "status_revision": {
      "type": "integer",
      "minimum": 0
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "project_status_mirror": {
      "$ref": "#/$defs/controlStatus",
      "description": "Last project.status value confirmed by the runtime. It must equal status before a transition commits."
    },
    "active_node": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/identifier"
        }
      ]
    },
    "run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/runRecord"
        }
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "problem",
        "design",
        "fieldwork",
        "data",
        "inference",
        "action",
        "visual",
        "submission"
      ],
      "properties": {
        "rule": {
          "$ref": "#/$defs/gateRecord"
        },
        "problem": {
          "$ref": "#/$defs/gateRecord"
        },
        "design": {
          "$ref": "#/$defs/gateRecord"
        },
        "fieldwork": {
          "$ref": "#/$defs/gateRecord"
        },
        "data": {
          "$ref": "#/$defs/gateRecord"
        },
        "inference": {
          "$ref": "#/$defs/gateRecord"
        },
        "action": {
          "$ref": "#/$defs/gateRecord"
        },
        "visual": {
          "$ref": "#/$defs/gateRecord"
        },
        "submission": {
          "$ref": "#/$defs/gateRecord"
        }
      }
    },
    "latest_checkpoint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/checkpointRecord"
        }
      ]
    },
    "event_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "last_sequence",
        "last_event_id"
      ],
      "properties": {
        "path": {
          "const": ".agent/events.jsonl"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "last_event_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "stream_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resume_from_checkpoint_id",
        "retry_count",
        "max_retries",
        "last_failure"
      ],
      "properties": {
        "status": {
          "enum": [
            "idle",
            "needed",
            "in_progress",
            "exhausted"
          ]
        },
        "resume_from_checkpoint_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "last_failure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failureRecord"
            }
          ]
        }
      }
    },
    "transition_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transitionRecord"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "nonEmptyPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*:)(?!.*(?:^|[/\\\\])\\.\\.?($|[/\\\\]))(?!.*[. ](?:$|[/\\\\]))[^\\x00-\\x1F]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controlStatus": {
      "enum": [
        "intake",
        "rule_lock",
        "problem_framing",
        "exploratory_research",
        "survey_design",
        "fieldwork",
        "data_analysis",
        "insight_action",
        "report_visual",
        "defense",
        "submission_ready",
        "closed"
      ]
    },
    "gateStatus": {
      "enum": [
        "not_run",
        "running",
        "pass",
        "warning",
        "fail",
        "unknown",
        "stale"
      ]
    },
    "gateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluation_id",
        "evaluated_at",
        "input_fingerprint",
        "result_path",
        "result_sha256",
        "fatal_count",
        "warning_count",
        "evidence_refs",
        "acknowledgement"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "evaluation_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "evaluated_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "input_fingerprint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "result_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonEmptyPath"
            }
          ]
        },
        "result_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "fatal_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acknowledgement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision_log_entry",
                "owner",
                "deadline"
              ],
              "properties": {
                "decision_log_entry": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "deadline": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "not_run"}}},
          "then": {
            "properties": {
              "evaluation_id": {"type": "null"},
              "evaluated_at": {"type": "null"},
              "input_fingerprint": {"type": "null"},
              "result_path": {"type": "null"},
              "result_sha256": {"type": "null"},
              "fatal_count": {"const": 0},
              "warning_count": {"const": 0},
              "evidence_refs": {"maxItems": 0},
              "acknowledgement": {"type": "null"}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["pass", "warning", "fail", "unknown", "stale"]}}},
          "then": {
            "properties": {
              "evaluation_id": {"$ref": "#/$defs/identifier"},
              "evaluated_at": {"type": "string", "format": "date-time"},
              "input_fingerprint": {"$ref": "#/$defs/sha256"},
              "result_path": {"$ref": "#/$defs/nonEmptyPath"},
              "result_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "pass"}}},
          "then": {
            "properties": {
              "fatal_count": {"const": 0},
              "evidence_refs": {"minItems": 1},
              "acknowledgement": {"type": "null"}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "warning"}}},
          "then": {
            "properties": {
              "fatal_count": {"const": 0},
              "warning_count": {"minimum": 1},
              "evidence_refs": {"minItems": 1},
              "acknowledgement": {"type": "object"}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "fail"}}},
          "then": {
            "properties": {
              "fatal_count": {"minimum": 1},
              "evidence_refs": {"minItems": 1},
              "acknowledgement": {"type": "null"}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "unknown"}}},
          "then": {
            "properties": {
              "fatal_count": {"minimum": 1},
              "acknowledgement": {"type": "null"}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "stale"}}},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    },
    "runRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "status",
        "attempt",
        "started_at",
        "updated_at",
        "input_fingerprint",
        "idempotency_key"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "running",
            "paused",
            "blocked",
            "failed",
            "succeeded",
            "cancelled"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_heartbeat_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkpointRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "project_id",
        "workflow_version",
        "gate_contract_version",
        "run_id",
        "node_id",
        "created_at",
        "status_revision",
        "project_revision",
        "event_sequence",
        "previous_checkpoint_id",
        "input_fingerprint",
        "artifacts",
        "resumable",
        "record_sha256"
      ],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/identifier"
        },
        "project_id": {
          "$ref": "#/$defs/identifier"
        },
        "workflow_version": {
          "const": "1.0.0"
        },
        "gate_contract_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "node_id": {
          "$ref": "#/$defs/identifier"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status_revision": {
          "type": "integer",
          "minimum": 0
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "previous_checkpoint_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/identifier"}
          ]
        },
        "input_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRecord"
          }
        },
        "resumable": {
          "type": "boolean"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "failureRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "class",
        "message",
        "retryable",
        "occurred_at"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "gate",
            "validation",
            "artifact_io",
            "integrity",
            "concurrency",
            "runtime",
            "external_dependency"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "transitionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "from",
        "to",
        "committed_at",
        "run_id",
        "checkpoint_id",
        "status_revision",
        "required_gates",
        "gate_snapshot_sha256"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/controlStatus"
        },
        "to": {
          "$ref": "#/$defs/controlStatus"
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/identifier"
        },
        "status_revision": {
          "type": "integer",
          "minimum": 1
        },
        "required_gates": {
          "type": "array",
          "items": {
            "enum": [
              "rule",
              "problem",
              "design",
              "fieldwork",
              "data",
              "inference",
              "action",
              "visual",
              "submission"
            ]
          },
          "uniqueItems": true
        },
        "gate_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
