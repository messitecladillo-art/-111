          "evidence/visual-preflight-checklist.csv"
        ]
      },
      {
        "id": "defense_to_submission_ready",
        "from": "defense",
        "to": "submission_ready",
        "required_gates": [
          "rule",
          "problem",
          "design",
          "fieldwork",
          "data",
          "inference",
          "action",
          "visual",
          "submission"
        ],
        "required_artifacts": [
          "deliverables/report",
          "deliverables/ppt",
          "deliverables/defense",
          "evidence/preflight-checklist.csv"
        ]
      },
      {
        "id": "submission_ready_to_closed",
        "from": "submission_ready",
        "to": "closed",
        "required_gates": [
          "rule",
          "problem",
          "design",
          "fieldwork",
          "data",
          "inference",
          "action",
          "visual",
          "submission"
        ],
        "required_artifacts": [
          "reviews/final-manifest.json",
          "evidence/decision-log.md"
        ]
      }
    ],
    "fatal_boundaries": [
      {
        "gate": "rule",
        "blocks_transition_ids": [
          "rule_lock_to_problem_framing"
        ],
        "skippable": false
      },
      {
        "gate": "problem",
        "blocks_transition_ids": [
          "problem_framing_to_exploratory_research"
        ],
        "skippable": false
      },
      {
        "gate": "design",
        "blocks_transition_ids": [
          "survey_design_to_fieldwork"
        ],
        "skippable": false
      },
      {
        "gate": "fieldwork",
        "blocks_transition_ids": [
          "fieldwork_to_data_analysis"
        ],
        "skippable": false
      },
      {
        "gate": "data",
        "blocks_transition_ids": [
          "data_analysis_to_insight_action"
        ],
        "skippable": false
      },
      {
        "gate": "inference",
        "blocks_transition_ids": [
          "data_analysis_to_insight_action"
        ],
        "skippable": false
      },
      {
        "gate": "action",
        "blocks_transition_ids": [
          "insight_action_to_report_visual"
        ],
        "skippable": false
      },
      {
        "gate": "visual",
