          "analysis/outputs",
          "evidence/evidence-ledger.csv"
        ]
      },
      {
        "id": "insight_action_to_report_visual",
        "from": "insight_action",
        "to": "report_visual",
        "required_gates": [
          "rule",
          "problem",
          "design",
          "fieldwork",
          "data",
          "inference",
          "action"
        ],
        "required_artifacts": [
          "evidence/evidence-ledger.csv",
          "evidence/decision-log.md"
        ]
      },
      {
        "id": "report_visual_to_defense",
        "from": "report_visual",
        "to": "defense",
        "required_gates": [
          "rule",
          "problem",
          "design",
          "fieldwork",
          "data",
          "inference",
          "action",
          "visual"
        ],
        "required_artifacts": [
          "deliverables/report",
          "deliverables/ppt",
