  "workflow": {
    "contract_id": "zhengda-cup-champion.workflow",
    "version": "1.0.0",
    "status_field": "project.status",
    "competition_stage_field": "project.stage",
    "initial_status": "intake",
    "terminal_statuses": [
      "closed"
    ],
    "stages": [
      {
        "id": "intake",
        "ordinal": 0,
        "terminal": false,
        "description": "Inspect available artifacts, establish provenance, and create or validate project state."
      },
      {
        "id": "rule_lock",
        "ordinal": 1,
        "terminal": false,
        "description": "Resolve edition, group, region, track, competition stage, and applicable official notices."
      },
      {
        "id": "problem_framing",
        "ordinal": 2,
        "terminal": false,
        "description": "Define the decision owner, decision, affected population, evidence gap, and expected action."
      },
      {
        "id": "exploratory_research",
        "ordinal": 3,
        "terminal": false,
        "description": "Establish the desk-research and qualitative basis for constructs and hypotheses."
      },
      {
        "id": "survey_design",
        "ordinal": 4,
        "terminal": false,
        "description": "Align population, sampling frame, instrument, variables, analysis plan, and decision use."
      },
      {
        "id": "fieldwork",
        "ordinal": 5,
        "terminal": false,
        "description": "Pilot and execute documented, consent-aware, provenance-preserving fieldwork."
      },
      {
        "id": "data_analysis",
        "ordinal": 6,
        "terminal": false,
        "description": "Clean, analyze, validate, and document the data without exceeding the design's inference strength."
      },
      {
        "id": "insight_action",
        "ordinal": 7,
        "terminal": false,
        "description": "Turn supported findings into owned, prioritized, measurable actions."
      },
      {
        "id": "report_visual",
        "ordinal": 8,
        "terminal": false,
        "description": "Produce synchronized report, appendix, presentation, and evidence-led visual artifacts."
      },
      {
        "id": "defense",
        "ordinal": 9,
        "terminal": false,
        "description": "Prepare and rehearse concise, technically owned responses to final-round scrutiny."
      },
      {
        "id": "submission_ready",
        "ordinal": 10,
        "terminal": false,
        "description": "Hold a fully audited, internally consistent, anonymity-safe submission candidate."
      },
      {
        "id": "closed",
        "ordinal": 11,
        "terminal": true,
        "description": "Record final handoff, immutable manifests, unresolved owner actions, and closure evidence."
      }
    ],
    "transition_policy": {
      "forward_only": true,
      "adjacent_only": true,
      "allow_self_transition": false,
      "allow_skip": false,
      "allow_manual_fatal_override": false,
      "recovery_changes_status": false,
      "required_global_preconditions": [
        "project_schema_valid",
        "agent_state_schema_valid",
        "current_status_matches_transition_from",
        "project_status_mirror_matches_agent_state",
        "expected_status_revision_matches",
        "single_writer_lock_held",
        "required_gate_results_are_current",
        "no_unresolved_fatal_finding",
        "checkpoint_committed_before_status_advance"
      ]
    },
    "gate_result_acceptance": {
      "accepted": [
        "pass",
        "warning"
      ],
      "warning_requires": [
        "decision_log_entry",
        "owner",
        "deadline"
      ],
      "blocking": [
        "not_run",
        "running",
        "fail",
        "unknown",
        "stale"
      ]
    },
