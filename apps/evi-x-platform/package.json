{
  "name": "evi-x-zhengda-champion-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3180",
    "dev:editor": "node scripts/start-editor.mjs",
    "dev:native-shell": "node native-shell/server.mjs",
    "prebuild": "npm run contract:check && npm run rules:check && node scripts/sync-defense-corpus.mjs && npm run security:assets && npm run knowledge:assets && npm run knowledge:check && npm run topic:check",
    "build": "next build --webpack",
    "postbuild": "node scripts/check-hosted-build.mjs",
    "start": "node scripts/start-hosted.mjs",
    "test": "npm run test:unit && npm run typecheck && npm run build",
    "test:diagnosis": "node --experimental-strip-types --test tests/diagnosis-actions.test.mjs",
    "test:agent": "node --experimental-strip-types --test tests/agent-services.test.mjs tests/agent-provider.test.mjs tests/agent-session.test.mjs tests/agent-questionnaire-proposal.test.mjs tests/agent-email-auth.test.mjs tests/agent-mail.test.mjs",
    "test:notice": "node --experimental-strip-types --test tests/competition-update.test.mjs",
    "test:harness": "node --test tests/bounded-command.test.mjs",
    "test:defense": "node --experimental-strip-types --test tests/defense-training.test.mjs tests/defense-import.test.mjs tests/pitch-rehearsal.test.mjs tests/action-evidence.test.mjs",
    "test:http-input": "node --test tests/http-input.test.mjs",
    "test:built-runtime": "node tests/built-runtime-probe.mjs",
    "test:office": "node --experimental-strip-types --test tests/office-package.test.mjs",
    "test:questionnaire": "node --experimental-strip-types --test tests/questionnaire.test.mjs tests/research-blocks.test.mjs tests/questionnaire-library.test.mjs tests/questionnaire-review.test.mjs tests/questionnaire-version.test.mjs tests/questionnaire-review-api.test.mjs tests/questionnaire-repair-origin.test.mjs tests/questionnaire-revision.test.mjs",
    "test:analysis": "node --experimental-strip-types --test tests/survey-analysis.test.mjs tests/analysis-recipes.test.mjs tests/analysis-plan.test.mjs tests/research-flow.test.mjs tests/questionnaire-mapping.test.mjs tests/row-eligibility.test.mjs tests/routing-evidence-flow.test.mjs tests/analysis-summary.test.mjs",
    "test:charts:stress": "node --expose-gc --experimental-strip-types scripts/chart-stress.mjs --release",
    "test:charts:browser": "node scripts/chart-browser-stress.mjs",
    "test:flight": "node --experimental-strip-types --test tests/evidence-flight.test.mjs",
    "test:editor": "node --experimental-strip-types --test tests/editor.test.mjs tests/report-storyboard.test.mjs",
    "test:bridge": "node scripts/run-bridge-tests.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "contract:sync": "node scripts/sync-control-contract.mjs --write",
    "contract:check": "node scripts/sync-control-contract.mjs --check",
    "rules:sync": "node scripts/sync-rule-corpus.mjs --write",
    "rules:check": "node scripts/sync-rule-corpus.mjs --check",
    "security:assets": "node scripts/check-build-assets.mjs",
    "knowledge:assets": "node scripts/check-knowledge-assets.mjs",
    "knowledge:check": "node --experimental-strip-types scripts/publish-knowledge.mjs",
    "security:cloud-bundle": "node scripts/check-cloud-bundle-isolation.mjs",
    "db:generate": "drizzle-kit generate",
    "test:legacy:http": "node tests/run-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "topic:check": "node --experimental-strip-types scripts/train-topic-advisor.mjs --check && node scripts/sync-topic-advisor.mjs && node scripts/sync-topic-regions.mjs && node scripts/sync-topic-region-api.mjs && node scripts/sync-topic-source-versions.mjs",
    "topic:train": "node --experimental-strip-types scripts/train-topic-advisor.mjs",
    "test:topics": "node --experimental-strip-types --test tests/topic-*.test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@evix/shared": "*",
    "@xyflow/react": "12.12.0",
    "docx": "^9.7.2",
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "jszip": "3.10.2",
    "katex": "0.16.29",
    "minisearch": "7.2.0",
    "next": "16.3.6",
    "pako": "3.0.2",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sax": "1.6.1",
    "tesseract.js": "7.0.0",
    "three": "0.186.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sax": "1.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "nanoid": "3.3.18",
    "undici": "7.29.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
