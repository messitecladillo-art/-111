{
  "schema_version": "1.0",
  "id": "initial_safe_state",
  "description": "Bootstrap starts at intake with neutral submission visuals; next and doctor do not advance state.",
  "steps": [
    {
      "id": "bootstrap",
      "run": ["bootstrap", "--title", "Initial Safe State"],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointer": "/status_after", "op": "eq", "value": "intake"},
        {"source": "json", "pointer": "/status_revision", "op": "eq", "value": 0},
        {"source": "json", "pointers": ["/gates/rule/status", "/gates/rule"], "op": "eq", "value": "not_run"},
        {"source": "file_text", "path": "project.yaml", "op": "regex", "value": "(?m)^  mode: competition_submission$"}
      ],
      "invariants": ["project_status_mirror", "event_stream_consistent"],
      "capture": {
        "initial_revision": {"source": "json", "pointer": "/status_revision"}
      }
    },
    {
      "id": "next_is_read_only",
      "run": ["next"],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointer": "/status_before", "op": "eq", "value": "intake"},
        {"source": "json", "pointer": "/status_after", "op": "eq", "value": "intake"},
        {"source": "json", "pointer": "/status_revision", "op": "eq", "value_from": {"capture": "initial_revision"}},
        {"source": "stdout", "op": "regex", "value": "rule_lock"}
      ],
      "invariants": ["project_status_mirror", "event_stream_consistent"]
    },
    {
      "id": "doctor_healthy",
      "run": ["doctor"],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointer": "/status_after", "op": "eq", "value": "intake"},
        {"source": "json", "pointer": "/status_revision", "op": "eq", "value_from": {"capture": "initial_revision"}}
      ],
      "invariants": ["project_status_mirror", "event_stream_consistent"]
    }
  ]
}
