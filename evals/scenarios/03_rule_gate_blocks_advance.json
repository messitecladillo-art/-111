{
  "schema_version": "1.0",
  "id": "rule_gate_blocks_advance",
  "description": "A not-run rule gate blocks rule_lock to problem_framing without changing status revision.",
  "steps": [
    {
      "id": "bootstrap",
      "run": ["bootstrap", "--title", "Rule Gate Block"],
      "expect_exit": 0,
      "invariants": ["project_status_mirror", "event_stream_consistent"]
    },
    {
      "id": "enter_rule_lock",
      "run": ["advance", "--to", "rule_lock"],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointer": "/status_after", "op": "eq", "value": "rule_lock"}
      ],
      "invariants": ["project_status_mirror", "adjacent_transition_only", "event_stream_consistent"],
      "capture": {
        "rule_lock_revision": {"source": "json", "pointer": "/status_revision"}
      }
    },
    {
      "id": "blocked_without_rule_gate",
      "run": ["advance", "--to", "problem_framing", "--expect-revision", "${capture.rule_lock_revision}"],
      "expect_exit": 1,
      "assert": [
        {"source": "json", "pointer": "/status_before", "op": "eq", "value": "rule_lock"},
        {"source": "json", "pointer": "/status_after", "op": "eq", "value": "rule_lock"},
        {"source": "json", "pointer": "/status_revision", "op": "eq", "value_from": {"capture": "rule_lock_revision"}},
        {"source": "json", "pointer": "/failure/class", "op": "eq", "value": "gate"},
        {"source": "stdout", "op": "regex", "value": "rule|gate|not_run|unknown|stale"}
      ],
      "invariants": ["project_status_mirror", "blocked_preserves_status", "event_stream_consistent"]
    }
  ]
}
