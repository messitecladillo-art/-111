{
  "schema_version": "1.0",
  "id": "evidenced_gate_allows_adjacent",
  "description": "Scoped official rule evidence can pass the rule gate and permit exactly one adjacent transition.",
  "steps": [
    {
      "id": "bootstrap",
      "run": ["bootstrap", "--title", "Evidence Gate Pass"],
      "expect_exit": 0,
      "invariants": ["project_status_mirror", "event_stream_consistent"]
    },
    {
      "id": "enter_rule_lock",
      "run": ["advance", "--to", "rule_lock"],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointer": "/status_after", "op": "eq", "value": "rule_lock"}
      ],
      "invariants": ["project_status_mirror", "adjacent_transition_only", "event_stream_consistent"]
    },
    {
      "id": "install_scoped_rules",
      "copy": {
        "from": "corpus-source/official-rules/edition16-undergrad-rules.json",
        "to": "evidence/rules.json"
      }
    },
    {
      "id": "install_scoped_rule_source",
      "copy": {
        "from": "corpus-source/official-rules/edition16-undergrad-practice-source.txt",
        "to": "evidence/rule-sources/edition16-undergrad-practice-source.txt"
      }
    },
    {
      "id": "scope_project",
      "replace": {
        "path": "project.yaml",
        "replacements": [
          {"old": "  edition: unknown", "new": "  edition: \"第十六届\""},
          {"old": "  group: unknown", "new": "  group: \"本科组\""},
          {"old": "  region: unknown", "new": "  region: \"全国\""},
          {"old": "  stage: unknown", "new": "  stage: \"校赛及企业命题赛\""},
          {"old": "  track: unknown", "new": "  track: \"自主选题\""},
          {"old": "  applicable_notice: unknown", "new": "  applicable_notice: \"evidence/rule-sources/edition16-undergrad-practice-source.txt\""}
        ]
      }
    },
    {
      "id": "set_rule_gate_pass",
      "run": ["gate", "set", "rule", "pass", "--evidence", "project.yaml", "--evidence", "evidence/rules.json"],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointers": ["/gates/rule/status", "/gates/rule"], "op": "eq", "value": "pass"}
      ],
      "invariants": ["project_status_mirror", "event_stream_consistent"],
      "capture": {
        "revision_before_advance": {"source": "json", "pointer": "/status_revision"}
      }
    },
    {
      "id": "advance_adjacent",
      "run": ["advance", "--to", "problem_framing", "--expect-revision", "${capture.revision_before_advance}"],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointer": "/status_before", "op": "eq", "value": "rule_lock"},
        {"source": "json", "pointer": "/status_after", "op": "eq", "value": "problem_framing"},
        {"source": "json", "pointer": "/status_revision", "op": "eq", "value_from": {"capture": "revision_before_advance", "add": 1}},
        {"source": "file_text", "path": "project.yaml", "op": "regex", "value": "(?m)^  status: problem_framing$"}
      ],
      "invariants": ["project_status_mirror", "adjacent_transition_only", "event_stream_consistent"]
    }
  ]
}
