{
  "schema_version": "1.0",
  "abstract": true,
  "extends": "_final_artifacts_registered.json",
  "steps": [
    {
      "id": "write_final_report_review_evidence",
      "write": {
        "path": "reviews/eval-final-report-review.json",
        "content": "{\"artifact_id\":\"ART-EVAL-FINAL-REPORT\",\"artifact_version\":\"v1\",\"artifact_sha256\":\"${capture.final_report_sha256}\",\"artifact_type\":\"report\",\"producer_role\":\"narrative_strategist\",\"owner_name\":\"report_owner\",\"decision\":\"approved\",\"reviewer_role\":\"red_team_judge\",\"reviewer_name\":\"independent_report_reviewer\",\"acceptance_test\":\"Artifact hash and rendered output remain current\",\"acceptance_checks\":[\"file_hash_current\",\"content_type_match\",\"report_structure_reviewed\",\"cross_file_consistency\"],\"completed_at\":\"2026-08-03T00:10:00Z\",\"findings\":\"No blocking findings\"}\n"
      }
    },
    {
      "id": "approve_final_report_review",
      "run": [
        "review", "approve", "ART-EVAL-FINAL-REPORT",
        "--evidence", "reviews/eval-final-report-review.json",
        "--reviewer-role", "red_team_judge",
        "--reviewer-name", "independent_report_reviewer",
        "--review-id", "REV-EVAL-FINAL-REPORT"
      ],
      "expect_exit": 0,
      "assert": [
        {"source": "json", "pointer": "/review/status", "op": "eq", "value": "approved"},
        {"source": "json", "pointer": "/review/artifact_sha256", "op": "eq", "value_from": {"capture": "final_report_sha256"}}
      ],
      "invariants": ["project_status_mirror", "event_stream_consistent"]
    },
